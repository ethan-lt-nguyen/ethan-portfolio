---
const currentPage = Astro.url.pathname;
---

<header>
  <nav class="top-nav">
    <a class="name" href="/">Ethan Nguyen</a>

    <div class="nav-links">
      <a class:list={{ active: currentPage === "/" }} href="/">
        Home
      </a>

      <a
        class:list={{ active: currentPage.startsWith("/research") }}
        href="/research/"
      >
        Research
      </a>

      <a
        class:list={{ active: currentPage.startsWith("/projects") }}
        href="/projects/"
      >
        Projects
      </a>

      <a
        class:list={{ active: currentPage.startsWith("/coursework") }}
        href="/coursework/"
      >
        Coursework
      </a>

      <a
        class:list={{ active: currentPage.startsWith("/about") }}
        href="/about/"
      >
        About
      </a>
    </div>
  </nav>
</header>