---
import Layout from "../layouts/Layout.astro";
import "../styles/tutoring.css";

/*
 * Replace each placeholder with the corresponding link generated by Square.
 */
const bookingUrl = "https://app.squareup.com/appointments/book/b2wwzi054sw6vw/LK5M63WGW27K5/start";
const consultationUrl = bookingUrl;
const tutoringUrl = bookingUrl;
const examPrepUrl = bookingUrl;
const lastMinuteUrl = bookingUrl;
---

<Layout
  title="Tutoring | Ethan Nguyen"
  description="Personalized mathematics, physics, and computer science tutoring."
>
  <main>
    <section class="tutoring-hero">
      <div class="tutoring-hero-text">
        <p class="section-label">Tutoring</p>

        <h1>Let’s work through it together.</h1>

        <p class="tutoring-introduction">
          I offer personalized tutoring in mathematics, introductory physics,
          and computer science. My goal is to help you understand why something
          works, you will not just memorize enough steps to finish an assignment.
        </p>

        <div class="tutoring-buttons">
          <a class="primary-button" href={bookingUrl}>
            Book a session
          </a>

          <a class="secondary-button" href="#subjects">
            View subjects
          </a>
        </div>
      </div>

      <aside class="availability-card">
        <p class="availability-label">Currently accepting students</p>

        <h2>Online and local tutoring</h2>

        <ul>
          <li>Sessions from 30 minutes to 2 hours</li>
          <li>Online or at an agreed public location</li>
          <li>Mathematics, physics, and computer science</li>
          <li>Email reminders through Square</li>
        </ul>

        <p class="availability-note">
          Not sure whether I cover your class? Send me a message before
          booking.
        </p>
      </aside>
    </section>

    <section class="tutoring-section" id="subjects">
      <div class="section-heading">
        <p class="section-label">Subjects</p>
        <h2>What I can help with</h2>
      </div>

      <div class="subject-grid">
        <article class="subject-card">
          <p class="subject-number">01</p>
          <h3>Mathematics</h3>

          <ul>
            <li>Algebra and trigonometry</li>
            <li>Precalculus</li>
            <li>Calculus</li>
            <li>Introductory differential equations</li>
            <li>Discrete mathematics</li>
            <li>Abstract algebra</li>
          </ul>
        </article>

        <article class="subject-card">
          <p class="subject-number">02</p>
          <h3>Computer Science</h3>

          <ul>
            <li>Introductory programming</li>
            <li>Java, Python, C++, C#, and Julia</li>
            <li>Object-oriented programming</li>
            <li>Data structures</li>
            <li>Debugging and project guidance</li>
            <li>Unity</li>
          </ul>
        </article>

        <article class="subject-card">
          <p class="subject-number">03</p>
          <h3>Calculus-Based Physics</h3>

          <ul>
            <li>Introductory mechanics</li>
            <li>Forces and energy</li>
            <li>Electricity and magnetism</li>
            <li>Problem-solving strategies</li>
            <li>Mathematical preparation for physics</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="tutoring-section">
      <div class="section-heading">
        <p class="section-label">Process</p>
        <h2>How a session works</h2>
      </div>

      <div class="process-list">
        <article class="process-step">
          <span>01</span>

          <div>
            <h3>Tell me what you’re working on</h3>

            <p>
              When booking, include the class, topic, and anything you are
              currently struggling with.
            </p>
          </div>
        </article>

        <article class="process-step">
          <span>02</span>

          <div>
            <h3>We work through it together</h3>

            <p>
              We’ll identify where the confusion starts and solve examples at
              your pace.
            </p>
          </div>
        </article>

        <article class="process-step">
          <span>03</span>

          <div>
            <h3>You leave with a plan</h3>

            <p>
              We’ll finish with the main ideas to remember and suggestions for
              what to practice next.
            </p>
          </div>
        </article>
      </div>
    </section>

    <section class="tutoring-section" id="sessions">
      <div class="section-heading">
        <p class="section-label">Sessions</p>
        <h2>Choose the help you need</h2>
      </div>

      <div class="pricing-grid">
        <article class="pricing-card">
          <p class="pricing-type">New students</p>
          <h3>Free Consultation</h3>

          <p class="price">
            Free <span>/ 15 minutes</span>
          </p>

          <p>
            A brief conversation to discuss your class, goals, schedule, and
            whether I’m the right tutor for you.
          </p>

          <ul class="session-details">
            <li>Discuss what you need help with</li>
            <li>Ask questions before booking</li>
            <li>No commitment required</li>
          </ul>

          <a class="secondary-button" href={consultationUrl}>
            Schedule a consultation
          </a>
        </article>

        <article class="pricing-card featured-pricing-card">
          <p class="pricing-type">Regular sessions</p>
          <h3>Flexible Tutoring</h3>

          <p class="price">
            From $20 <span>/ 30 minutes</span>
          </p>

          <p>
            Personalized help with homework, difficult concepts, practice
            problems, debugging, or general course questions.
          </p>

          <ul class="session-options">
            <li>
              <span>30 minutes</span>
              <strong>$20</strong>
            </li>

            <li>
              <span>1 hour</span>
              <strong>$40</strong>
            </li>

            <li>
              <span>1 hour 30 minutes</span>
              <strong>$55</strong>
            </li>

            <li>
              <span>2 hours</span>
              <strong>$70</strong>
            </li>
          </ul>

          <a class="primary-button" href={tutoringUrl}>
            Choose a session
          </a>
        </article>

        <article class="pricing-card">
          <p class="pricing-type">Focused preparation</p>
          <h3>Exam Prep</h3>

          <p class="price">
            From $40 <span>/ 1 hour</span>
          </p>

          <p>
            Prepare for an upcoming quiz, midterm, or final by reviewing
            important concepts and working through practice problems.
          </p>

          <ul class="session-options">
            <li>
              <span>1 hour</span>
              <strong>$40</strong>
            </li>

            <li>
              <span>1 hour 30 minutes</span>
              <strong>$55</strong>
            </li>

            <li>
              <span>2 hours</span>
              <strong>$70</strong>
            </li>
          </ul>

          <a class="secondary-button" href={examPrepUrl}>
            Book exam prep
          </a>
        </article>
      </div>

      <div class="urgent-session">
        <div>
          <p class="pricing-type">Exam within 48 hours?</p>
          <h3>Last-Minute Exam Help</h3>

          <p>
            Urgent, focused help when your exam is approaching quickly. Choose
            a 30-minute session for $30 or a one-hour session for $55.
            Availability is limited.
          </p>
        </div>

        <a class="secondary-button" href={lastMinuteUrl}>
          Check availability
        </a>
      </div>

      <p class="pricing-note">
        Two-hour sessions may include a short break. If you need additional
        support, you can book multiple sessions or contact me to create a study
        plan. Payments are securely processed through Square.
      </p>
    </section>

    <section class="tutoring-section tutoring-about">
      <div>
        <p class="section-label">Your tutor</p>
        <h2>A little about me</h2>
      </div>

      <div class="tutoring-about-text">
        <p>
          I’m Ethan Nguyen, a computer science and mathematics student at San
          Diego State University with additional interests in physics and
          computational science.
        </p>

        <p>
          I have experience helping students learn programming and technical
          subjects. I have worked with Thinkist before, tutoring two kids struggling in mathematics, and
          I teach students how to code at Code Ninjas.
        </p>

        <p>
          I know that these courses can feel overwhelming, so I try
          to make difficult ideas approachable without making students feel
          uncomfortable for asking questions.
        </p>

        <a class="text-link" href="/about">
          More about me →
        </a>
      </div>
    </section>

    <section class="booking-banner">
      <div>
        <p class="section-label">Ready to begin?</p>
        <h2>Book your first session.</h2>

        <p>
          Start with a free consultation or choose the tutoring session that
          works best for you.
        </p>
      </div>

      <a class="booking-button" href={bookingUrl}>
        View all available sessions
      </a>
    </section>
  </main>
</Layout>