---
import BaseLayout from "../layouts/Layout.astro";
import "../styles/coursework.css";
---

<BaseLayout title="Coursework | Ethan Nguyen">
  <section class="page-heading">
    <h1>Coursework</h1>

    <p>
      A selection of all the coursework I have taken that is relevant towards my future goals.
    </p>
  </section>

  <section class="coursework-section">
  <div class="main-course-grid">
    <article class="course-card">
      <h2>Mathematics Courses</h2>

      <ul class="course-list">
        <li>
          <strong>MATH 252</strong>
          <span>Calculus III</span>
        </li>

        <li>
          <strong>MATH 237</strong>
          <span>Elementary Differential Equations</span>
        </li>

        <li>
          <strong>MATH 245</strong>
          <span>Discrete Mathematics</span>
        </li>

        <li>
          <strong>MATH 254</strong>
          <span>Introduction to Linear Algebra</span>
        </li>

        <li>
          <strong>MATH 320</strong>
          <span>Abstract Algebra</span>
        </li>

        <li>
          <strong>MATH 524</strong>
          <span>Linear Algebra</span>
        </li>
      </ul>

      <div class="course-tags">
        <span>Computational Mathematics</span>
        <span>Pure Mathematics</span>
      </div>
    </article>

    <article class="course-card">
      <h2>Computer Science Courses</h2>

      <ul class="course-list">
        <li>
          <strong>CS 210</strong>
          <span>Data Structures</span>
        </li>

        <li>
          <strong>CS 240</strong>
          <span>Computer Organization</span>
        </li>

        <li>
          <strong>CS 250</strong>
          <span>Introduction to Software Systems</span>
        </li>

        <li>
          <strong>CS 420</strong>
          <span>Advanced Programming Languages</span>
        </li>

        <li>
          <strong>CS 549</strong>
          <span>Machine Learning</span>
        </li>

        <li>
          <strong>CS 559</strong>
          <span>Computer Vision</span>
        </li>
      </ul>

      <div class="course-tags">
        <span>Programming</span>
        <span>Software Development</span>
        <span>Machine Learning</span>
        <span>Computer Vision</span>
      </div>
    </article>
  </div>

  <article class="course-card physics-card">
    <h2>Physics Courses</h2>

    <ul class="course-list">
      <li>
        <strong>PHYS 195–197</strong>
        <span>Mechanics, Electricity and Magnetism, and Waves</span>
      </li>

      <li>
        <strong>PHYS 350</strong>
        <span>Classical Mechanics</span>
      </li>
    </ul>

    <div class="course-tags">
      <span>Physics</span>
      <span>Mathematical Physics</span>
    </div>
  </article>
</section>
</BaseLayout>